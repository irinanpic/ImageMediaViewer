{
  "id": "format.sample",
  "name": "Sample Binary Image Format Support",
  "version": "1.0.0",
  "description": "ユーザー独自画像フォーマット追加のサンプル設定マニフェスト（再ビルド不要）",
  "extensions": [
    "sampleimg"
  ],
  "magic_header": "SAMPLE",
  "extractor": {
    "type": "binary_slice",
    "start_signature": "89504E470D0A1A0A",
    "end_signature": "49454E44AE426082",
    "include_end_signature": true,
    "mime_type": "image/png"
  },
  "actions": [
    {
      "id": "action.open_sample",
      "name": "サンプルツールで開く",
      "name_en": "Open with Sample Tool",
      "icon": "Play",
      "order": 35,
      "extensions": [
        "sampleimg"
      ],
      "command": {
        "windows": [
          "C:\\Windows\\system32\\mspaint.exe"
        ],
        "default": "mspaint",
        "args": [
          "{path}"
        ]
      }
    }
  ]
}
